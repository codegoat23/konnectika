# ---------------------------------------------------------------------------
# Konnectika — environment template
#
# Copy to `.env.local` and fill in real values. NEVER commit a populated .env.
#
#   cp .env.example .env.local
#
# Every value below is a placeholder. Do not paste production secrets here.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database (Prisma + PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/konnectika"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/konnectika_shadow"
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/konnectika_test"

# ---------------------------------------------------------------------------
# Clerk  (Dashboard -> API Keys)
#
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY and NEXT_PUBLIC_CLERK_SIGN_IN_URL /
# SIGN_UP_URL are exposed to the browser; that is expected for these two
# publishable values only. The SECRET key must stay server-side.
#
# The publishable key is prefixed pk_test_ / pk_live_ and the secret key with
# sk_test_ / sk_live_. Never expose the secret key or the webhook signing
# secret to the client or commit them.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Route the Clerk components are mounted at. Must match the paths in
# app/sign-in/[[...sign-in]] and app/sign-up/[[...sign-up]].
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Optional: after signing in, send users here instead of the Clerk dashboard.
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"

# Clerk webhooks -> Sync Clerk users into Prisma.
# Dashboard -> Webhooks -> endpoint URL must be:
#   https://YOUR_DOMAIN/api/webhooks/clerk
# Subscribe to: user.created, user.updated, user.deleted
CLERK_WEBHOOK_SIGNING_SECRET=""

# ---------------------------------------------------------------------------
# Admin accounts (provisioned on boot by instrumentation.ts)
#
# Comma-separated. ADMIN_PASSWORD must be >= 8 characters. Changing the
# password re-syncs the stored hash on the next server start. Leave
# ADMIN_EMAILS blank to disable the bootstrap.
#
# Note these admins authenticate through Clerk like everyone else; this only
# provisions their Konnectika User row (role ADMIN).
# ---------------------------------------------------------------------------
ADMIN_EMAILS=""
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Platform fee percentages
#
# DEFAULTS only. An admin changing a percentage in the dashboard writes a
# PlatformSetting row, which takes priority over these.
# ---------------------------------------------------------------------------
PLATFORM_CREATOR_FEE_PERCENT="10"
PLATFORM_BRAND_FEE_PERCENT="10"

# ---------------------------------------------------------------------------
# Snippe (mobile money collection + payouts)
# ---------------------------------------------------------------------------
SNIPPE_API_KEY=""
SNIPPE_WEBHOOK_SECRET=""
SNIPPE_WEBHOOK_URL=""
# Snippe has no collection-fee quote endpoint, so this is an estimate that is
# reconciled against the real settlement fee in the webhook.
SNIPPE_COLLECTION_FEE_PERCENT="0"

# Shared secret for calling POST /api/payouts/generate from a scheduler.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Public brand campaign inquiries (Resend transactional email)
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
CAMPAIGN_NOTIFICATION_EMAIL=""
# Verified sender address/domain in Resend, e.g. Konnectika <inquiries@example.com>
CAMPAIGN_SENDER_EMAIL=""

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Keep the local value for development. Production should set this to the
# canonical origin; sitemap.xml, robots.txt, and canonical metadata use it.
# Production origin: https://wekonnectika.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
UPLOADTHING_TOKEN=""

# Public brand campaign inquiries (Resend transactional email)
RESEND_API_KEY=""
CAMPAIGN_NOTIFICATION_EMAIL=""
# Verified sender address/domain in Resend, e.g. Konnectika <inquiries@example.com>
CAMPAIGN_SENDER_EMAIL=""

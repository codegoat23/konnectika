generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CREATOR
  BRAND
  ADMIN
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String?

  // Clerk owns identity and credentials. This is the link between a Clerk
  // user id and the Konnectika user row, and is the unique key every sync
  // path (signup, webhook, sign-in) keys off. Nullable so pre-Clerk rows and
  // env-bootstrapped admins can still exist and be linked later.
  clerkUserId String? @unique

  role           Role     @default(CREATOR)
  onboardingStep Int      @default(1)
  onboardingDone Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  creatorProfile  CreatorProfile?
  businessProfile BusinessProfile?
  notifications   Notification[]

  submittedPaymentProofs PaymentProof[] @relation("PaymentProofSubmittedBy")
  reviewedPaymentProofs  PaymentProof[] @relation("PaymentProofReviewedBy")
}

model CreatorProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  username    String? @unique
  displayName String?

  phone           String?
  phoneVerified   Boolean               @default(false)
  earnings        Earning[]
  submissions     Submission[]
  payouts         Payout[]
  socialAccounts  SocialAccount[]
  applications    CampaignApplication[]
  platformRevenue PlatformRevenue[]
  payoutAccount   PayoutAccount?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([username])
}

model BusinessProfile {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String? @unique
  logo        String?
  website     String?

  industry       String?
  description    String?
  socialAccounts SocialAccount[]

  // 🔥 RELATION: business creates campaigns
  campaigns       Campaign[]
  platformRevenue PlatformRevenue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyName])
}

model SocialAccount {
  id String @id @default(cuid())

  creatorId  String?
  businessId String?

  creator  CreatorProfile?  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  business BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  platform SocialPlatform
  handle   String
  url      String?

  followers Int     @default(0)
  verified  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, platform])
  @@unique([businessId, platform])
  @@index([creatorId])
  @@index([businessId])
}

enum SocialPlatform {
  TWITTER
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  LINKEDIN
}

model Campaign {
  id String @id @default(cuid())

  name        String
  description String
  category    String

  campaignType CampaignTypeEnum
  badge        BadgeType

  thumbnailColor    String
  thumbnailPic      String
  thumbnailInitials String

  paymentRate  Int
  budgetFunded Int @default(0)
  budgetTotal  Int

  // 💳 Payment snapshot — backend source of truth (see lib/pricing.ts).
  // Computed from budgetTotal at creation/edit time and SNAPSHOTTED here, so
  // changing the fee % later never rewrites history. Existing campaigns keep
  // the defaults (UNPAID, 0/0/0) until their next edit.
  paymentStatus   CampaignPaymentStatus @default(UNPAID)
  platformFeeRate Int                   @default(0) // percent charged to the brand
  platformFee     Int                   @default(0) // budgetTotal * platformFeeRate / 100
  totalCharge     Int                   @default(0) // budgetTotal + platformFee

  // 💳 Brand payment details (how the brand pays the platform). The phone is
  // captured for mobile-money methods so the platform can match the incoming
  // transfer when confirming the campaign as PAID.
  paymentMethod String?
  paymentPhone  String?

  daysLeft Int

  contentFormat String
  duration      String

  applicationsClose DateTime

  isOpenToAll Boolean @default(true)
  isFeatured  Boolean @default(false)

  // ⭐ NEW FIELDS (from your frontend)
  tags           String[]
  requirements   String[]
  creatorsJoined Int            @default(0)
  brand          String?
  status         CampaignStatus @default(PENDING_REVIEW)

  // relations
  businessProfileId String
  businessProfile   BusinessProfile       @relation(fields: [businessProfileId], references: [id], onDelete: Cascade)
  submissions       Submission[]
  platforms         Platform[]
  applications      CampaignApplication[]
  platformRevenue   PlatformRevenue[]
  earnings          Earning[]
  paymentProofs     PaymentProof[]
  paymentIntents    PaymentIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessProfileId])
  @@index([status])
}

enum CampaignStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum CampaignPaymentStatus {
  UNPAID // created but the brand has not paid yet
  AWAITING_PAYMENT // a Snippe payment intent is live and the brand has been asked to authorize it
  PROOF_SUBMITTED // LEGACY manual flow: the brand submitted a payment proof, awaiting admin verification
  PAYMENT_FAILED // the latest Snippe attempt failed/expired; the brand may retry
  PAID // funds confirmed — set ONLY by a verified Snippe webhook (or legacy admin proof verification)
}

enum BadgeType {
  active
  hot
  new
  featured
}

enum Platform {
  instagram
  tiktok
  facebook
  youtube
  x
}

enum CampaignTypeEnum {
  UGC
  Sponsored
  Affiliate
  Ambassador
}

model CampaignApplication {
  id String @id @default(cuid())

  creatorId  String
  campaignId String

  message String?

  status ApplicationStatus @default(PENDING)

  // optional but VERY useful (snapshot at time of apply)
  instagramFollowers Int?
  tiktokFollowers    Int?
  youtubeFollowers   Int?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  submission Submission?
  earning    Earning?

  creator  CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  campaign Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([creatorId, campaignId])
  @@index([creatorId])
  @@index([campaignId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================================
// ADD THIS TO YOUR EXISTING prisma/schema.prisma
// Do not create a separate schema file — Prisma needs one file
// (or use multi-file schemas if you're on Prisma 5.15+ with the
// `prismaSchemaFolder` preview feature enabled).
// ============================================================

// --- 1. New enum: submission lifecycle -----------------------
// Mirrors FLOW.md's verification step (SUBMITTED -> review -> done)
// without colliding with your existing ApplicationStatus enum.
enum SubmissionStatus {
  PENDING_REVIEW // creator just submitted, nothing reviewed yet
  SUBMITTED // legacy alias for PENDING_REVIEW
  UNDER_REVIEW // brand has opened it / started reviewing
  APPROVED // brand approved -> can feed into payment stage later
  CHANGES_REQUESTED // brand asked creator to fix/redo
  REJECTED // brand rejected outright
}

// --- 2. New model: Submission ---------------------------------
model Submission {
  id String @id @default(cuid())

  // Link back to the approved application this proof is for.
  // We key off applicationId (not just campaignId + creatorId)
  // because the application is the record that proves this
  // creator was actually approved for this campaign.
  applicationId String              @unique // one submission per application (see note below)
  application   CampaignApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Denormalized for fast filtering/joins without always
  // having to traverse application -> campaign / creator.
  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // --- proof content ---
  screenshots String[] // array of uploaded file URLs (S3 / Supabase Storage)
  postLinks   String[] // array of live post URLs (Instagram/TikTok/etc.)
  caption     String? // optional note from creator describing the submission

  earning    Earning?
  status     SubmissionStatus @default(SUBMITTED)
  reviewNote String? // brand's feedback / reason for rejection or change request
  reviewedAt DateTime?
  reviewedBy String? // userId of the brand/admin who reviewed it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([campaignId])
  @@index([status])
}

// --- 3. Relations you need to ADD to existing models -----------
//
// In model CreatorProfile, add:
//   submissions Submission[]
//
// In model Campaign, add:
//   submissions Submission[]
//
// In model CampaignApplication, add:
//   submission  Submission?
//
// NOTE on "one submission per application":
// applicationId is @unique above, which means a creator gets exactly
// ONE submission row per approved application. If you want creators
// to be able to submit multiple times (e.g. resubmit after
// CHANGES_REQUESTED), remove the @unique constraint and instead treat
// each resubmission as a NEW row, then always show the latest one in
// the UI (order by createdAt desc, take the first). Given FLOW.md's
// "Request changes 🔁" step, multiple submissions per application is
// probably the more realistic long-term model — flagged here so you
// can decide. The API code below is written to support EITHER choice
// with a one-line change (see comment in app/api/submissions/route.ts).

model Earning {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Direct links to the campaign and the approved application the earning
  // came from. Campaign is REQUIRED (backfilled from submission on migrate);
  // application is set when the earning is created at application approval.
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  applicationId String?              @unique
  application   CampaignApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  // Linked once content is approved (nullable because an earning is created
  // at APPLICATION approval, before any content exists).
  submissionId String?     @unique
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // --- payment breakdown (gross / fee / net) ---
  amount          Int // gross campaign payment
  platformFeeRate Int @default(0) // percent
  platformFee     Int @default(0)
  creatorAmount   Int @default(0) // net the creator earns

  status EarningStatus @default(PENDING)

  // --- settlement timeline (admin approval only) ---
  requestedAt DateTime? // when the earning was created (application approval)
  approvedAt  DateTime?
  availableAt DateTime? // set when the admin approves the earning (APPROVED -> AVAILABLE)

  // --- scheduled payout linkage (monthly creator payout system) ---
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  // --- platform revenue linkage (CREATOR_FEE deducted from this earning) ---
  platformRevenue PlatformRevenue?

  createdAt DateTime  @default(now())
  paidAt    DateTime? // set when the payout covering this earning is paid

  @@index([creatorId])
  @@index([campaignId])
  @@index([status])
  @@index([payoutId])
}

enum EarningStatus {
  PENDING // created at application approval, awaiting content approval
  APPROVED // content approved by the brand, awaiting admin settlement approval
  AVAILABLE // admin approved, rolls into the next payout
  PAID // settled through a payout
  REJECTED // content rejected -> no payout
}

model Notification {
  id      String           @id @default(cuid())
  title   String
  message String
  type    NotificationType
  isRead  Boolean          @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

// ============================================================
// PLATFORM REVENUE
// Immutable, auditable records of money earned by the platform.
// Every row snapshots the fee rate and amounts in effect at the
// time of the underlying money event, so later config changes
// never alter historical records.
// ============================================================

enum PlatformRevenueType {
  CREATOR_FEE // 10% (configurable) deducted from a creator's gross earning
  BRAND_FEE // 5%  (configurable) charged to a brand on campaign creation
}

enum PlatformRevenueStatus {
  ACCRUED // recorded when the underlying money event happens
  PAID // funds actually received by the platform
}

model PlatformRevenue {
  id String @id @default(cuid())

  type   PlatformRevenueType
  status PlatformRevenueStatus @default(ACCRUED)

  // snapshot of the fee configuration at record time
  feeRate     Int // percent
  grossAmount Int // amount the fee was computed against
  feeAmount   Int // money the platform keeps (grossAmount * feeRate / 100)

  // optional external payment reference / invoice number
  paymentReference String?

  // links
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  creatorId String? // set for CREATOR_FEE
  creator   CreatorProfile? @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  businessId String? // set for BRAND_FEE
  business   BusinessProfile? @relation(fields: [businessId], references: [id], onDelete: Restrict)

  earningId String?  @unique // set for CREATOR_FEE -> the earning the fee was deducted from
  earning   Earning? @relation(fields: [earningId], references: [id], onDelete: Restrict)

  description String?

  createdAt DateTime @default(now())

  // Idempotency: a retried money event cannot create a duplicate revenue row.
  // (earningId is @unique, so an earning can fund at most one CREATOR_FEE.)
  //
  // A campaign can have MANY approved creators, so CREATOR_FEE rows must not
  // be limited to one per campaign. The unique key therefore discriminates on
  // businessId (NULL for CREATOR_FEE, set for BRAND_FEE): Postgres treats NULL
  // as distinct in unique indexes, so any number of CREATOR_FEE rows may exist
  // per campaign, while BRAND_FEE stays unique per campaign+business.
  @@unique([campaignId, type, businessId])
  @@index([campaignId])
  @@index([creatorId])
  @@index([businessId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// SCHEDULED CREATOR PAYOUTS
// ============================================================
//
// Monthly, admin-review payout batches. When a creator's AVAILABLE earnings
// cross the platform's minimum payout threshold, a Payout row is created
// (on the monthly payout day via runScheduledPayouts(), or by the creator
// requesting one once eligible). The creator's earnings are frozen into the
// payout (payoutId) so they stop counting toward the available balance, and
// the admin approves / rejects / marks the payout PAID manually.
//
//   PENDING  -> created by the schedule or a creator request (funds frozen)
//   APPROVED -> admin reviewed and approved the payout
//   PAID     -> admin processed the manual payment (earnings become PAID)
//   REJECTED -> admin declined; earnings are unfrozen and roll over
//
// A rejected / excess balance rolls to the next month because only earnings
// that were AVAILABLE at payout creation are frozen; anything below the
// threshold stays in the available balance automatically.

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING // handed to Snippe, awaiting the payout.completed / payout.failed webhook
  PAID
  FAILED // Snippe reported payout.failed; funds returned to the Snippe balance
  REJECTED
}

model Payout {
  id String @id @default(cuid())

  creatorId String
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Sum of the linked earnings' creatorAmount at payout creation. Never
  // exceeds the creator's available balance (enforced in lib/payout.ts).
  amount Int

  status PayoutStatus @default(PENDING)

  // Creator's chosen settlement destination (captured at request time).
  paymentMethod String?
  paymentPhone  String?

  // --- Snippe disbursement ---
  // `amount` above is what the CREATOR receives (the sum of the frozen
  // earnings' creatorAmount). `feeAmount` is the Snippe payout fee and
  // `totalAmount` is what actually leaves the platform balance. The platform
  // absorbs the fee for now — it is NEVER deducted from `amount`.
provider               String? // "snippe"
  providerReference      String? @unique // Snippe payout `reference` (webhook lookup)
  providerExternalRef    String? // upstream processor reference
  feeAmount           Int     @default(0)
  totalAmount         Int?
  narration           String?
  failureReason       String?

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  sentAt      DateTime? // handed to Snippe
  paidAt      DateTime?
  rejectedAt  DateTime?

  // Admin settlement details (manual payment in V1).
  paymentReference String?
  rejectionReason  String?
  reviewedBy       String? // admin userId
  reviewedAt       DateTime?

  earnings Earning[]

  paymentProofs PaymentProof[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([status])
}

// ============================================================
// PLATFORM SETTINGS (key/value)
// ============================================================
//
// Admin-editable platform configuration. Currently used by the payout system:
//   payout.minimumAmount  -> minimum payout threshold in TZS (default 50000)
//   payout.day            -> monthly payout day-of-month (default 25)
// Values are stored as strings and parsed by lib/payout.ts. Missing rows
// fall back to the defaults in lib/payout.ts.

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
// MANUAL PAYMENT SYSTEM
// ============================================================
//
// One reusable payment-proof model drives BOTH money flows so there is a
// single, auditable trail:
//   - BRAND -> KONNEKTIKA campaign payment: a PaymentProof linked to the
//     campaign is created when the brand submits proof of payment; the admin
//     verifies or rejects it. Verification flips the campaign paymentStatus
//     to PAID (reusing the existing campaign-funding logic).
//   - KONNEKTIKA -> CREATOR payout: the admin records the proof they created
//     while processing a payout; the payout only becomes PAID once that
//     proof is stored (status VERIFIED).
//
// Lifecycle (campaign proofs):  UNPAID > submit proof > PROOF_SUBMITTED >
// admin verifies (PAID) or rejects (back to UNPAID with a reason).

enum PaymentProofStatus {
  PROOF_SUBMITTED // proof submitted, awaiting admin verification
  VERIFIED // admin confirmed the payment
  REJECTED // admin rejected the proof with a reason
}

enum ReceivingAccountType {
  MOBILE_MONEY
  BANK
}

model PaymentProof {
  id String @id @default(cuid())

  // Links: either a campaign (brand paying the platform) or a payout
  // (platform paying a creator). Exactly one of these is set.
  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Set when this proof was produced by a verified Snippe webhook, so an
  // automated proof can always be traced back to the attempt that caused it.
  paymentIntentId String?
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)

  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  // who submitted/recorded the proof
  submittedById String?
  submittedBy   User?   @relation("PaymentProofSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)

  amount               Int
  paymentMethod        String
  transactionReference String
  proofUrl             String?
  note                 String?
  status               PaymentProofStatus @default(PROOF_SUBMITTED)

  // Provider plumbing. Snippe-populated proofs are created by the verified
  // webhook (not typed by a human), which is why the proof is kept as a pure
  // audit record: `providerReference` is the Snippe payment/payout reference.
  provider          String?
  providerReference String?

  // admin review fields
  reviewedById    String?
  reviewedBy      User?     @relation("PaymentProofReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([campaignId])
  @@index([payoutId])
  @@index([status])
}

// ============================================================
// SNIPPE PAYMENT COLLECTION (brand -> Konnectika)
// ============================================================
//
// A PaymentIntent is ONE attempt by a brand to pay for a campaign through
// Snippe. A campaign accumulates many intents across retries (a failed or
// expired attempt is superseded by a new one); only the campaign's
// `paymentStatus` reflects the current state.
//
// Amounts are a SNAPSHOT taken at intent-creation time:
//   totalCharge = budgetTotal + platformFee + estimatedProviderFee
// The estimate is what the brand was shown and charged. The REAL Snippe fee
// arrives in the `payment.completed` webhook (`data.settlement.fees`) and is
// written back to `actualProviderFee` / `actualNetAmount`, so the estimate can
// be reconciled against reality without ever rewriting what was charged.

enum PaymentIntentStatus {
  AWAITING_PAYMENT // intent created with Snippe; USSD push sent to the brand
  PROCESSING // Snippe confirmed the intent is in flight
  PAID // payment.completed webhook verified and applied
  FAILED // payment.failed / expired / voided
}

model PaymentIntent {
  id String @id @default(cuid())

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Sequential attempt number per campaign (1, 2, 3 …) so retries are ordered.
  attempt Int @default(1)

  // <= 30 chars, enforced in lib/snippe.ts. @unique makes a duplicate
  // submission with the same key a no-op instead of a double charge.
  idempotencyKey String @unique

  // ---- amount snapshot (integer TZS, never floats) ----
  budgetTotal     Int
  platformFeeRate Int
  platformFee     Int
  providerFeeRate Int // estimated Snippe collection rate, percent (bps-style int)
  providerFee     Int // ESTIMATED Snippe collection fee shown to the brand
  totalCharge     Int // budgetTotal + platformFee + providerFee

  // ---- real figures, written only from a verified webhook ----
  actualProviderFee Int?
  actualNetAmount   Int? // gross - real Snippe fee, credited to the balance

  // ---- provider plumbing ----
  provider            String  @default("snippe")
  providerReference   String? @unique // Snippe `reference` from POST /v1/payments
  providerExternalRef String? // upstream processor reference
  channel             String? // "mpesa" | "airtel" | "mixx" | "halotel"
  customerPhone       String?
  customerName        String?
  customerEmail       String?

  status        PaymentIntentStatus @default(AWAITING_PAYMENT)
  failureReason String?
  expiresAt     DateTime?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentProofs PaymentProof[]

  // Attempt numbers are allocated per campaign, so this composite unique key is
  // what stops two concurrent "pay" requests claiming the same attempt (and
  // therefore the same Snippe idempotency key) at once.
  @@unique([campaignId, attempt])
  @@index([status])
}

// Idempotency ledger for inbound provider webhooks. `id` is the provider's
// event id, which is the dedupe key — a repeated delivery collides on the
// primary key and is skipped, making webhook handling harmless to retry.
model WebhookEvent {
  id          String    @id // provider event id (dedupe key)
  provider    String    @default("snippe")
  type        String // "payment.completed", "payout.failed", …
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([type])
  @@index([receivedAt])
}

// Konnectika's admin-configured receiving accounts. Brands never type these
// numbers themselves — the UI reads the active account matching the payment
// method, so nothing is ever hardcoded in campaign components.
model ReceivingAccount {
  id String @id @default(cuid())

  type          ReceivingAccountType
  provider      String // mobile money method ("M-PESA", …) or bank name
  accountName   String
  phone         String? // mobile money receiving number
  accountNumber String? // bank account number
  branchDetail  String? // branch / reference details
  extraDetails  String? // other relevant bank details
  isActive      Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

// A creator's saved payout destination, managed from their dashboard. The
// admin uses this when processing a creator payout so the money goes to the
// account the creator specified.
model PayoutAccount {
  id        String         @id @default(cuid())
  creatorId String         @unique
  creator   CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  method        String // "M-PESA" | "Airtel Money" | "Tigo Pesa" | "Bank Transfer" | …
  phone         String? // mobile money receiving phone
  accountName   String? // payee name (mobile money or bank)
  bankName      String? // bank transfer
  accountNumber String? // bank transfer

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
